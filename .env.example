# Copy this file to .env and adjust values for your environment.
# .env is git-ignored; never commit real secrets.

# --- Core ---
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL as a single connection string...
DATABASE_URL=postgres://clinic_hub:clinic_hub@localhost:5432/clinic_hub
# ...or set the individual POSTGRES_* variables below (used if DATABASE_URL is not set).
POSTGRES_DB=clinic_hub
POSTGRES_USER=clinic_hub
POSTGRES_PASSWORD=clinic_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cache (Redis) ---
# Single connection string: redis://[:password@]host:port/db_number
CACHE_URL=redis://localhost:6379/1

# --- Email ---
# Set to true and configure SMTP vars below to send real email (e.g. in staging/production).
DJANGO_EMAIL_USE_SMTP=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
